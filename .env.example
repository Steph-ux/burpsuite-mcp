# BurpSuite host & HTTP proxy (works on both Community and Pro)
BURP_HOST=127.0.0.1
BURP_PORT=8080

# BurpSuite Pro REST API (leave BURP_API_KEY empty for Burp Community or unauthenticated Pro REST API)
BURP_API_PORT=1337
BURP_API_KEY=

# API key transport when BURP_API_KEY is set:
#   auto   = try native Burp Pro URL-path (/KEY/v0.1/...), auto-fallback to headers if needed
#   path   = native Burp Pro REST API URL-path mode
#   header = third-party extension headers (X-Burp-Api-Token / API-KEY / Authorization)
BURP_API_KEY_MODE=auto

# Edition mode:
#   auto      = use REST API when reachable (:1337), seamless local Community fallback otherwise
#   community = local/proxy mode with automatic bridge detection if loaded
#   pro       = strict Burp Pro REST API mode
BURP_EDITION=auto

# Set to true only if you installed Burp's CA cert into Node's trust store
BURP_PROXY_TLS_REJECT_UNAUTHORIZED=false
